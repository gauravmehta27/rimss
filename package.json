{
  "name": "rimms",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run dev:ssr",
    "dev:ssr": "concurrently -k -n api,ssr -c magenta,green \"npm:mock-api\" \"npm run build && node dist/rimms/server/server.mjs\"",
    "serve:web": "ng serve",
    "mock-api": "node mock-api/server.js",
    "build": "ng build",
    "build:icons": "node tools/build-icon-subset.mjs",
    "preview": "ng build && node mock-api/server.js --serve-dist",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --no-watch",
    "lint:format": "prettier --check \"src/**/*.{ts,html,scss,json}\"",
    "serve:ssr:rimms": "node dist/rimms/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@11.5.2",
  "dependencies": {
    "@angular/common": "22.1.7",
    "@angular/compiler": "22.1.7",
    "@angular/core": "22.1.7",
    "@angular/forms": "22.1.7",
    "@angular/platform-browser": "22.1.7",
    "@angular/platform-server": "22.1.7",
    "@angular/router": "22.1.7",
    "@angular/ssr": "^22.1.7",
    "admin-lte": "^4.9.1",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "express": "^5.1.0",
    "overlayscrollbars": "^2.11.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.1.7",
    "@angular/cli": "22.1.7",
    "@angular/compiler-cli": "22.1.7",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.0.8",
    "compression": "^1.8.1",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "graphql": "^17.0.2",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
